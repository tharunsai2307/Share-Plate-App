# SharePlate Root Monorepo EAS Ignore
# Ensures only essential mobile and shared workspace files are packaged for EAS Build

# ─── Accidental Nested Expo Template (475 MB) ──────────────────────────────────
apps/mobile/share-plate/
**/share-plate/

# ─── Dependencies & Caches (Builder installs via package-lock.json) ───────────
**/node_modules/
node_modules/
.expo/
.next/
.npm/

# ─── Non-Mobile Services & Docs ───────────────────────────────────────────────
supabase/
docs/
scripts/

# ─── Binaries, Executables & Launchers ─────────────────────────────────────────
*.exe
*.bat
SharePlate-Mobile.exe

# ─── Git & IDE Metadata ───────────────────────────────────────────────────────
.git/
.vscode/
.idea/

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env*.local

# ─── Tests, Coverage & Logs ───────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Native Build Cache ───────────────────────────────────────────────────────
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/ios/Pods/
