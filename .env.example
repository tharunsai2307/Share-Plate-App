# SharePlate Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file with real credentials.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe to embed in client bundles (RLS protects data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — ONLY for Edge Functions / server-side / CI
# NEVER place this in any client bundle, mobile app, or public web app
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct database connection string (for migrations / CI testing only)
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── Expo / EAS ──────────────────────────────────────────────────────────────
# Your EAS project ID (from eas.json or expo.dev dashboard)
EAS_PROJECT_ID=your-eas-project-id

# Expo account slug
EXPO_SLUG=shareplate

# ─── Admin Web ───────────────────────────────────────────────────────────────
# Internal admin secret for server-side operations (generate with: openssl rand -hex 32)
ADMIN_API_SECRET=your-random-secret-min-32-chars

# ─── App Configuration ───────────────────────────────────────────────────────
# Base URL for the admin web app (used in emails, links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Push Notifications ──────────────────────────────────────────────────────
# Firebase Cloud Messaging server key (for Android push notifications via Expo)
# Configured in EAS project settings, not needed in local dev
# FCM_SERVER_KEY=your-fcm-server-key
