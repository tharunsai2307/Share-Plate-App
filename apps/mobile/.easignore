node_modules/
.expo/
.npm/

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env*.local
.env.local

# ─── Build Artifacts & Tests ──────────────────────────────────────────────────
dist/
build/
coverage/
*.log
